# 환경 변수 예시. 복사해서 .env.local로 쓴다: cp .env.example .env.local
# .env.local은 git에 올라가지 않는다. 비밀 값은 .env.local에만 넣는다.
# 모두 비워 두면 아래 기본값으로 동작한다.

# 녹화·세션 기록 저장 폴더 (기본: 프로젝트의 data/)
# data/에는 미성년자 영상·음성이 담길 수 있으니 git에 올리지 않는다.
NOVALAB_DATA_DIR=

# 녹화 전체 보관 한도, GB 단위 (기본: 20)
RECORDINGS_QUOTA_GB=20

# 운영진 이메일(쉼표로 여러 개). 이 이메일로 가입하면 승인 없이 바로 운영진이 된다. 첫 운영진을 만드는 방법이다.
# 나머지 강사는 가입 신청 후 운영진이 '강사 관리' 화면에서 승인해야 로그인할 수 있다.
ADMIN_EMAILS=
# 로그인 쿠키 서명 키(선택). 비워 두면 data/.session-secret을 처음 한 번 만들어 쓴다. 바꾸면 모두 로그아웃된다.
SESSION_SECRET=
# 1이면 이 컴퓨터(localhost)에서 연 요청은 로그인 없이 '로컬 관리자'로 들어온다. 개발·테스트용. 배포에는 절대 넣지 않는다.
LOCAL_NO_LOGIN=

# --- OpenAI (AI 피드백) ---
# 실제 키는 .env.local에만 넣는다. 예시 파일에는 절대 넣지 않는다.
# 수업 녹화(학생 음성 포함)가 해외 서버로 전송되므로, 동의 범위를 확인한 뒤 켠다.
OPENAI_API_KEY=

# 음성 → 텍스트 변환 모델
OPENAI_TRANSCRIBE_MODEL=whisper-1

# 루브릭 채점·피드백 작성에 쓸 모델 (정해지면 채운다)
OPENAI_MODEL=gpt-4o-mini

# 음성 추출에 쓸 ffmpeg 경로 (기본: npm으로 설치된 ffmpeg-static)
FFMPEG_PATH=
